// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum CarStatus {
  ACTIVE
  MAINTENANCE
  RETIRED
}

enum CarTransmission {
  MANUAL
  AUTOMATIC
}

enum CarFuelType {
  DIESEL
  PETROL
  ELECTRIC
}

enum ContractStatus {
  ACTIVE
  COMPLETED
  CANCELED
}

enum Role {
  OWNER
  STAFF
}

model Company {
  id                   String             @id @default(cuid())
  name                 String
  logoUrl              String?
  subscriptionStatus   SubscriptionStatus @default(TRIALING)
  trialEndsAt          DateTime
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  currentPriceId       String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  users        User[]
  cars         Car[]
  clients      Client[]
  contracts    Contract[]
  reservations Reservation[]
}

// One row per login: the company's own OWNER account plus up to 3 STAFF
// accounts it creates. Both roles have identical access to the app itself —
// the only thing STAFF can't do is manage users.
model User {
  id           String   @id @default(cuid())
  companyId    String
  username     String   @unique
  passwordHash String
  role         Role     @default(STAFF)
  createdAt    DateTime @default(now())

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@index([companyId])
}

// Database-backed session so removing a staff user immediately invalidates
// any session they're still holding, not just future logins.
model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Car {
  id                     String           @id @default(cuid())
  companyId              String
  plate                  String
  make                   String
  model                  String
  year                   Int?
  registrationExpiryDate DateTime         @db.Date
  transmission           CarTransmission?
  fuelType               CarFuelType?
  status                 CarStatus        @default(ACTIVE)
  createdAt              DateTime         @default(now())

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contracts    Contract[]
  reservations Reservation[]

  @@unique([companyId, plate])
  @@index([companyId])
}

model Client {
  id                 String    @id @default(cuid())
  companyId          String
  firstName          String
  lastName           String
  birthDate          DateTime  @db.Date
  passportNumber     String?
  passportIssueDate  DateTime? @db.Date
  passportExpiryDate DateTime? @db.Date
  licenceNumber      String?
  licenceIssueDate   DateTime? @db.Date
  licenceExpiryDate  DateTime? @db.Date
  phone              String?
  createdAt          DateTime  @default(now())

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contractDrivers ContractDriver[]

  @@index([companyId])
  @@index([companyId, firstName, lastName])
}

model Contract {
  id         String         @id @default(cuid())
  companyId  String
  carId      String
  startDate  DateTime       @db.Date
  endDate    DateTime       @db.Date
  dailyPrice Decimal?       @db.Decimal(10, 2)
  totalPrice Decimal?       @db.Decimal(10, 2)
  status     ContractStatus @default(ACTIVE)
  createdAt  DateTime       @default(now())

  company Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  car     Car              @relation(fields: [carId], references: [id])
  drivers ContractDriver[]

  @@index([companyId])
  @@index([carId, startDate, endDate])
}

// A contract can list more than one driver. Each row links a contract to a
// Client (which may be reused/autocompleted across contracts, same as the
// single-driver model before), with `order` preserving driver 1, 2, 3…
model ContractDriver {
  id         String @id @default(cuid())
  contractId String
  clientId   String
  order      Int    @default(0)

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  client   Client   @relation(fields: [clientId], references: [id])

  @@unique([contractId, clientId])
  @@index([contractId])
  @@index([clientId])
}

// A lightweight pre-contract hold on a car for a date range — just a client
// name, no full driver profile. Created by clicking a free cell in the
// fleet availability matrix.
model Reservation {
  id         String   @id @default(cuid())
  companyId  String
  carId      String
  clientName String
  startDate  DateTime @db.Date
  endDate    DateTime @db.Date
  createdAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  car     Car     @relation(fields: [carId], references: [id])

  @@index([companyId])
  @@index([carId, startDate, endDate])
}
