// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum CarStatus {
  ACTIVE
  MAINTENANCE
  RETIRED
}

enum ContractStatus {
  ACTIVE
  COMPLETED
  CANCELED
}

model Company {
  id                 String             @id @default(cuid())
  name               String
  subscriptionStatus SubscriptionStatus @default(TRIALING)
  stripeCustomerId   String?            @unique
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  users     User[]
  cars      Car[]
  clients   Client[]
  contracts Contract[]
}

model User {
  id           String   @id @default(cuid())
  companyId    String
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model Car {
  id        String    @id @default(cuid())
  companyId String
  plate     String
  make      String
  model     String
  year      Int
  status    CarStatus @default(ACTIVE)
  createdAt DateTime  @default(now())

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contracts Contract[]

  @@unique([companyId, plate])
  @@index([companyId])
}

model Client {
  id                  String    @id @default(cuid())
  companyId           String
  firstName           String
  lastName            String
  birthDate           DateTime  @db.Date
  passportNumber      String?
  passportIssueDate   DateTime? @db.Date
  passportExpiryDate  DateTime? @db.Date
  licenceNumber       String?
  licenceIssueDate    DateTime? @db.Date
  licenceExpiryDate   DateTime? @db.Date
  phone               String?
  createdAt           DateTime  @default(now())

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contractDrivers ContractDriver[]

  @@index([companyId])
  @@index([companyId, firstName, lastName])
}

model Contract {
  id         String         @id @default(cuid())
  companyId  String
  carId      String
  startDate  DateTime       @db.Date
  endDate    DateTime       @db.Date
  dailyPrice Decimal?       @db.Decimal(10, 2)
  totalPrice Decimal?       @db.Decimal(10, 2)
  status     ContractStatus @default(ACTIVE)
  createdAt  DateTime       @default(now())

  company Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  car     Car              @relation(fields: [carId], references: [id])
  drivers ContractDriver[]

  @@index([companyId])
  @@index([carId, startDate, endDate])
}

// A contract can list more than one driver. Each row links a contract to a
// Client (which may be reused/autocompleted across contracts, same as the
// single-driver model before), with `order` preserving driver 1, 2, 3…
model ContractDriver {
  id         String @id @default(cuid())
  contractId String
  clientId   String
  order      Int    @default(0)

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  client   Client   @relation(fields: [clientId], references: [id])

  @@unique([contractId, clientId])
  @@index([contractId])
  @@index([clientId])
}
