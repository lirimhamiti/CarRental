DATABASE_URL="postgresql://user:password@localhost:5432/carrental?schema=public"

# Your own (product owner) login for the /admin panel. Generate the hash with:
#   npx tsx scripts/hash-password.ts yourpassword
# Next.js expands $VARIABLE references in .env files, and bcrypt hashes start
# with $2b$10$... — escape every "$" in the hash as "\$" or the value gets
# silently corrupted. Example: "\$2b\$10\$abc...".
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH=""

# Random secret used to sign the admin session cookie. Generate with:
#   openssl rand -hex 32
ADMIN_SESSION_SECRET=""

# Optional — only needed to upload company logos from the admin panel.
# Auto-provided when you enable Vercel Blob storage on your Vercel project.
BLOB_READ_WRITE_TOKEN=""

# From your Stripe dashboard (sandbox/test keys while testing, live keys once
# you switch to a live account). Only the secret key is used server-side —
# there's no client-side Stripe.js, since checkout uses Stripe-hosted pages.
STRIPE_SECRET_KEY=""

# From the webhook endpoint you create in the Stripe dashboard, pointed at
# https://yourapp.vercel.app/api/billing/webhook — Stripe shows this once you
# create that endpoint. Listen for: checkout.session.completed,
# customer.subscription.updated, customer.subscription.deleted.
STRIPE_WEBHOOK_SECRET=""
